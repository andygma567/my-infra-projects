# Example terraform.tfvars file
# Copy this file to terraform.tfvars (or use envs/<env>/tofu.tfvars) and customize.

# Basic Configuration
# region MUST be one of atl1, nyc2, ams3 (regions where managed NFS is GA).
region       = "nyc2"
cluster_name = "my-slurm-cluster"

# Droplet sizes
head_node_size    = "s-1vcpu-512mb-10gb" # SLURM controller + accounting database
compute_node_size = "s-1vcpu-512mb-10gb" # SLURM compute node

# Managed Network File Storage (shared filesystem)
nfs_size_gib         = 50         # minimum 50 GiB
nfs_performance_tier = "standard" # "standard" or "high"
nfs_mount_point      = "/shared"  # local mount path on every node

# Image (Ubuntu 22.04 LTS recommended)
droplet_image = "ubuntu-22-04-x64"

# The number of SLURM compute nodes to create
compute_node_count = 2
